  {
    "type": "custom",
    "name": "find_openings",
    "description": "Get real service windows after intake is complete. Without a known preference, omit date filters to check the earliest openings; otherwise use the caller's local dates and time preference. a valid, confirmed email is mandatory. Returns exact slot IDs. Never invent slots.",
    "url": "https://summit-api-production-80be.up.railway.app/tools/find_openings",
    "method": "POST",
    "args_at_root": false,
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "start_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "end_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "time_of_day": {
          "pattern": "^(any|morning|afternoon)$",
          "type": "string"
        }
      },
      "type": "object"
    },
    "speak_during_execution": true,
    "speak_after_execution": true,
    "timeout_ms": 15000,
    "max_retry": 0,
    "execution_message_description": "Briefly say you're checking openings for a technician to take a look. Don't claim availability yet."
  },
  {
    "type": "custom",
    "name": "book_selected",
    "description": "Book the exact offered slot only after explicit caller agreement. A valid, confirmed email is required; never book after an email refusal. Check booking_status and appointment before confirming. Never retry an uncertain result blindly.",
    "url": "https://summit-api-production-80be.up.railway.app/tools/book_selected",
    "method": "POST",
    "args_at_root": false,
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "slot_id": {
          "maxLength": 100,
          "minLength": 1,
          "type": "string"
        },
        "caller_confirmed": {
          "type": "boolean"
        }
      },
      "required": [
        "slot_id",
        "caller_confirmed"
      ],
      "type": "object"
    },
    "speak_during_execution": true,
    "speak_after_execution": true,
    "timeout_ms": 15000,
    "max_retry": 0,
    "execution_message_description": "Briefly say you're arranging the selected visit. Do not say booked until the result."
  },

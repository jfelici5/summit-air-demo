# Retell: create an account, enable billing, complete requested verification.
RETELL_API_KEY=
# Retell Settings → API Keys: use the key with the "Webhook" badge for signatures.
# This may differ from RETELL_API_KEY. It is a Retell-issued key, not a new secret.
RETELL_WEBHOOK_API_KEY=
# If you have already purchased a number, use its international format (+1...).
RETELL_PHONE_NUMBER=

# Railway: account/workspace API token for provisioning and deployment.
# This is RAILWAY_API_TOKEN, not an environment-scoped RAILWAY_TOKEN.
RAILWAY_API_TOKEN=

# Cal.com: API key. Leave event type blank; it can be configured during setup.
CAL_API_KEY=
CAL_EVENT_TYPE_ID=

# Inquiry receipts from the helpdesk Gmail account through Google Apps Script.
# Sender implementation: scripts/gmail_inquiry_sender.gs.
# SMTP and a Gmail app password are not used.
INQUIRY_EMAIL_URL=
INQUIRY_EMAIL_TOKEN=

# Generated during provisioning. Keep real values only in the ignored .env file.
RAILWAY_PROJECT_ID=
RAILWAY_ENVIRONMENT_ID=
RAILWAY_SERVICE_ID=
DEMO_POSTGRES_PASSWORD=
PUBLIC_BASE_URL=
RETELL_AGENT_ID=
RETELL_LLM_ID=
ADMIN_API_KEY=
CAL_WEBHOOK_SECRET=

# Local SQLite; production uses Railway's persistent Postgres service reference.
ENVIRONMENT=local
DATABASE_URL=sqlite:///./data/summit.db

# Fictional demo operations, configurable when real customer policies are known.
SERVICE_COUNTIES=Nassau,Suffolk,Queens
SERVICE_STATE=NY
SERVICE_TIMEZONE=America/New_York
APPOINTMENT_MINUTES=120
COLD_THRESHOLD_F=40
EXTREME_HEAT_THRESHOLD_F=90
PROVIDER_TIMEOUT_SECONDS=6
WEATHER_ENABLED=true
RETELL_VOICE_ID=11labs-Adrian
